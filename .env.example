# Copie para ".env" (NAO commite o .env). Em producao use variaveis de ambiente do host.

# --- Banco de dados ---
DB_CONNECTION=Host=localhost;Database=ValorantDB;Username=postgres;Password=TROQUE_ESTA_SENHA

# --- Seguranca (OBRIGATORIO em producao) ---
# Gere com: openssl rand -base64 48   (minimo 32 caracteres)
JWT_SECRET=

# --- Origem(ns) do frontend para CORS, separadas por virgula ---
FRONTEND_URL=http://localhost:5173

# --- Provedor de dados: "henrik" (API nao oficial) ou "riot" (API oficial da Riot) ---
DATA_PROVIDER=henrik

# Henrik (so se DATA_PROVIDER=henrik)
HENRIK_BASEURL=https://api.henrikdev.xyz
HENRIK_APIKEY=

# Riot oficial (so se DATA_PROVIDER=riot)
RIOT_API_KEY=
RIOT_PLATFORM=br          # host de plataforma do VALORANT: br, na, eu, ap, kr, latam
RIOT_REGION=americas      # host regional da conta: americas, europe, asia

# --- Limitador de chamadas de SAIDA para a API externa ---
# Chave de desenvolvimento Riot: 100 req / 2 min (padrao abaixo e conservador)
# Chave de producao Riot: 500 req / 10 s e 30000 req / 10 min por regiao
UPSTREAM_MAX_REQUESTS=
UPSTREAM_WINDOW_SECONDS=

# --- Riot Sign On (RSO) - so apos a Riot liberar o client para a sua chave de producao ---
RSO_ENABLED=false
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
RSO_REDIRECT_URI=https://SEU-BACKEND/api/v1/rso/callback

# --- Opcional ---
ENABLE_SWAGGER=false
